/* Plain styling that follows the terminal's own colours (ANSI theme). */

#topbar {
    height: 1;
    margin: 0 0 1 0;
}
#folder-tag {
    text-style: bold reverse;
}
#folder {
    width: 1fr;
    padding: 0 1;
}
#counts {
    width: auto;
}

#main {
    height: 1fr;
}

#table {
    width: 1fr;
    height: 1fr;
    border: round ansi_bright_black;
}
#table:focus {
    border: round $primary;
}

#side {
    width: 46;
    border: round ansi_bright_black;
    padding: 0 1;
}
#side-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}
#cover {
    width: auto;
    height: auto;
    margin: 0 0 0 1;
}
#cover-img {
    width: 24;
    height: auto;
    margin: 0 0 0 1;
}
#cover-info {
    margin: 0 0 1 0;
}
#keys {
    color: ansi_bright_black;
}

#progress-row {
    height: 1;
    padding: 0 1;
}
#progress {
    width: auto;
}
#progress-label {
    color: $secondary;
}

#log {
    height: 7;
    border: round ansi_bright_black;
    scrollbar-size-vertical: 1;
}

/* ---------- dialogs ---------- */
ModalScreen {
    align: center middle;
}
.dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    border: round $primary;
    padding: 1 2;
    overflow-y: auto;
}
.dialog.wide {
    width: 100;
}
.dialog-title {
    text-style: bold;
    margin: 0 0 1 0;
}
.dialog DirectoryTree {
    height: 18;
    border: round ansi_bright_black;
    margin: 1 0 0 0;
}
.dialog OptionList {
    height: auto;
    max-height: 24;
    border: round ansi_bright_black;
}
.dialog .hint-top {
    color: ansi_bright_black;
    margin: 0 0 1 0;
}
#search-dialog DataTable {
    height: 1fr;
    min-height: 6;
    max-height: 100%;
}
#search-dialog {
    height: 90%;
    width: 120;
    max-width: 95%;
}
.dialog .hint {
    color: ansi_bright_black;
    margin: 1 0 0 0;
}
.dialog .body {
    margin: 0 0 1 0;
}
.dialog .preview {
    margin: 1 0 0 0;
}
.buttons {
    height: auto;
    margin: 1 0 0 0;
    align: right middle;
}
.buttons Button {
    margin: 0 0 0 2;
}

#form {
    grid-size: 2;
    grid-columns: 16 1fr;
    grid-rows: 1;
    grid-gutter: 1 0;
    height: auto;
}
.form-label {
    height: 1;
}
#form Input {
    height: 1;
    border: none;
    padding: 0 1;
    background: ansi_default;
    text-style: underline;
}
#form Input:focus {
    text-style: bold underline;
    color: $primary;
}

/* ---------- smaller terminals ---------- */
Screen.-narrow #side {
    width: 36;
}
Screen.-short #log {
    height: 5;
}
Screen.-short #topbar {
    margin: 0;
}
